{
  "mcpServers": {
    "companion_collector": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "bin\\mcp.cmd",
        "mcp"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "LOCALAPPDATA",
        "USERPROFILE",
        "COMPANION_DATA_DIR",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 120
    }
  }
}
