{
  "mcpServers": {
    "native_assist": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "bin\\launch.cmd",
        "mcp"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "CODEX_CLI_PATH",
        "LOCALAPPDATA",
        "USERPROFILE",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY",
        "NO_PROXY"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 900
    }
  }
}
